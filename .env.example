# Public browser configuration. These values are safe to expose.
NEXT_PUBLIC_API_URL=http://localhost:8787
NEXT_PUBLIC_NEON_AUTH_URL=https://your-neon-auth-url.neonauth.example
NEXT_PUBLIC_NEON_DATA_API_URL=https://your-neon-data-api-url.neon.tech

# Node API configuration. The API URL is public, but is server-scoped here.
NEON_DATA_API_URL=https://your-neon-data-api-url.neon.tech
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Migration-only secret. Never expose this to the browser or commit a real value.
DATABASE_URL=postgresql://role:password@host/database?sslmode=require

